# ============================================================================
# persist.list (v7.0 — نسخه‌ی پاک برای vpshamid1-svg)
#   ریشه‌های «داده/تنظیمات کاربر» که هر ۵ دقیقه اسکن و بکاپ می‌شوند.
#
#   تفاوت با نسخه‌ی قبلی:
#     * مسیرهای Hermes agent / uv حذف شدند (این برنامه‌ها منتقل نمی‌شوند).
#     * داده‌های 3x-ui از طریق /etc/x-ui کاملاً ماندگار است؛ باینری حجیم آن
#       عمداً آرشیو نمی‌شود و در ریبیلد به‌طور خودکار بازنصب می‌شود.
# ============================================================================

# فایل‌های شخصی و محیط root/Hamid
/home/Hamid
/root

# هویت Tailscale (Node Key => حفظ IP ثابت)
/var/lib/tailscale

# کانفیگ‌های سیستمی کاربر (/etc) — فایل‌های گذرای image فیلتر می‌شوند
/etc

# برنامه‌ها و ابزارهای افزوده‌شده توسط کاربر در مسیرهای محلی
/usr/local/bin
/usr/local/sbin
# نکته (v7.0): /usr/local/x-ui عمداً اینجا نیست — باینری حجیم (~200MB) وارد
# آرشیو state نمی‌شود. داده‌های پنل (/etc/x-ui شامل x-ui.db) از طریق /etc
# کاملاً ماندگارند و خودِ باینری در هر ریبیلد توسط provision.sh وقتی داده وجود
# داشته باشد به‌طور خودکار بازنصب می‌شود (recovery).

# وب‌سرورها، سرویس‌ها و زمان‌بندی
/opt
/srv
/var/www
/var/spool/cron

# داده‌های عمومی سرویس‌ها (دیتابیس و …)
/var/lib
/var/opt
